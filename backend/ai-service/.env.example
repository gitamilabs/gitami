# =============================================================================
# AI Service Environment Configuration Template
# Copy this file to `.env` in `backend/ai-service/` and fill in your credentials.
# =============================================================================

# =============================================================================
# SELECTOR KEYS — Change these two lines to switch backends with no code changes
# =============================================================================

# VECTOR_DB options: chroma_local | chroma_cloud | qdrant | pinecone | supabase | memory
VECTOR_DB=chroma_local

# EMBEDDER options: gemini | openai | fastembed
EMBEDDER=gemini

# =============================================================================
# LLM & GRAPH ORCHESTRATION KEYS
# =============================================================================

# Google Gemini API Key (Used for Reviewer Orchestration & Default Embedder)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Used for fast parallel worker node diff hunk analysis)
GROQ_API_KEY=your_groq_api_key_here

# Neo4j Graph Database Credentials (Code Graph Knowledge Base)
NEO4J_URI=neo4j+s://<YOUR_CLOUD_NEO4J_ID>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<YOUR_CLOUD_NEO4J_PASSWORD>
NEO4J_DATABASE=neo4j

# =============================================================================
# EMBEDDER CONFIGURATIONS
# =============================================================================

# Gemini Embedder (used when EMBEDDER=gemini)
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI Embedder (used when EMBEDDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # or text-embedding-3-large (dim=3072)

# FastEmbed Embedder — Local ONNX, no GPU needed (used when EMBEDDER=fastembed)
# Model downloads ~130 MB on first use to ~/.cache/fastembed/
# Other options: BAAI/bge-base-en-v1.5 (dim=768), snowflake/snowflake-arctic-embed-xs (dim=384)
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# =============================================================================
# VECTOR STORE CONFIGURATIONS
# =============================================================================

# ChromaDB (used when VECTOR_DB=chroma_local or chroma_cloud)
CHROMA_PERSIST_DIR=./chroma_db       # Local storage path (chroma_local only)
CHROMA_BATCH_SIZE=40

# Chroma Cloud (all three must be set to activate chroma_cloud):
CHROMA_API_KEY=your_chroma_cloud_api_key
CHROMA_TENANT=your_tenant_id
CHROMA_DATABASE=your_database_name

# Qdrant (used when VECTOR_DB=qdrant)
QDRANT_URL=https://<YOUR_CLUSTER>.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=knowledge_base
QDRANT_BATCH_SIZE=100

# Pinecone (used when VECTOR_DB=pinecone)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=knowledge-base
PINECONE_ENVIRONMENT=us-east-1
PINECONE_BATCH_SIZE=100

# Supabase pgvector (used when VECTOR_DB=supabase)
# Run vector/stores/supabase_migration.sql once in your Supabase SQL editor first.
SUPABASE_URL=https://<YOUR_PROJECT>.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_TABLE=knowledge_base
SUPABASE_BATCH_SIZE=50
