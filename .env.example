# =============================================================================
# Gitami Monorepo Environment Setup Guide
# =============================================================================
# Each application in `apps/` manages its own environment variables:
#
# 1. apps/web/  -> apps/web/.env.local  (Next.js Web UI)
# 2. apps/api/  -> apps/api/.env.local  (Bun/Hono API Service)
# 3. apps/ai/   -> apps/ai/.env         (FastAPI AI / Indexer Intelligence Service)
#
# =============================================================================
# Local Services (docker-compose up -d)
# =============================================================================
# - PostgreSQL: localhost:5432 (user: gitami, pass: gitamipassword, db: gitami)
# - Neo4j:      bolt://localhost:7687 (user: neo4j, pass: gitamipassword)
#               http://localhost:7474 (Neo4j Browser UI)
#
# =============================================================================
# 1. apps/web/.env.local
# =============================================================================
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
#
# =============================================================================
# 2. apps/api/.env.local
# =============================================================================
# PORT=5000
# NODE_ENV=development
# FRONTEND_URL=http://localhost:3000
# AI_SERVICE_URL=http://localhost:8000
# DB_URL=postgresql://gitami:gitamipassword@localhost:5432/gitami
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/auth/github/callback
# GITHUB_APP_ID=your_github_app_id
# GITHUB_APP_SLUG=your_github_app_slug
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=your_webhook_secret
# JWT_SECRET=your_jwt_secret_min_32_characters
#
# =============================================================================
# 3. apps/ai/.env
# =============================================================================
# VECTOR_DB=supabase (or chroma_local | chroma_cloud | qdrant | pinecone | memory)
# EMBEDDER=fastembed (or gemini | openai)
# GEMINI_API_KEY=your_gemini_api_key
# GROQ_API_KEY=your_groq_api_key
# NEO4J_URI=bolt://localhost:7687 (or neo4j+s://<id>.databases.neo4j.io)
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=gitamipassword
# NEO4J_DATABASE=neo4j
